# YuE2 Song Studio — local configuration
# Copy to .env. Replace /Users/YOUR_USER/... with your actual workspace path.

HOST=127.0.0.1
PORT=8000
DEBUG=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000

# Engine
ENGINE=mlx
MLX_YUE_BIN=/Users/YOUR_USER/Documents/deepseek-harness/default-workspace/engines/mlx-Yue/.venv/bin/mlx-yue
MLX_MODEL_DIR=/Users/YOUR_USER/Documents/deepseek-harness/default-workspace/models/mlx-Yue2-3B
MLX_VAE_DIR=/Users/YOUR_USER/Documents/deepseek-harness/default-workspace/models/YuE2-Vae
MLX_PRECISION=8bit
MLX_MEMORY_BUDGET_GB=14
MLX_DEFAULT_STEPS=8
MLX_FINAL_STEPS=32
MLX_MAX_DURATION=360
MLX_JOB_TIMEOUT_SECONDS=2400
MLX_OFFLINE=true

# Lyrics only
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_OLLAMA_MODEL=qwen-fast:latest
OLLAMA_TIMEOUT_SECONDS=180
WARN_QWEN_MAX_PARAMS_B=8

# Media tools
FFMPEG_BIN=/Users/YOUR_USER/Documents/deepseek-harness/default-workspace/tools/ffmpeg/bin/ffmpeg
FFPROBE_BIN=/Users/YOUR_USER/Documents/deepseek-harness/default-workspace/tools/ffmpeg/bin/ffprobe
DEMUCS_BIN=/Users/YOUR_USER/Documents/deepseek-harness/default-workspace/Music_draft2/.venv/bin/demucs-onnx
HF_HOME=/Users/YOUR_USER/Documents/deepseek-harness/default-workspace/models/hf-cache

# Storage
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/studio.db
OUTPUTS_DIR=./outputs
UPLOADS_DIR=./uploads
VOICES_DIR=./voices
WORKFLOWS_DIR=./workflows
CONFIG_DIR=./config
LOGS_DIR=./logs
FRONTEND_DIST=./frontend/dist

# Limits
MAX_UPLOAD_MB=60
MIN_FREE_MEMORY_GB=3.0
MAX_CONCURRENT_HEAVY_JOBS=1
