# ==============================================================================
# YuE2 Song Studio Environment Configuration
# Copy this file to .env and adjust values for your Mac Apple Silicon setup.
# Never commit .env to source control.
# ==============================================================================

# Backend Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# Frontend Configuration
FRONTEND_PORT=3000

# Ollama Configuration (Local LLM for Lyrics and Prompt Encoding)
OLLAMA_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=120

# ComfyUI Configuration (Local Music Generation Engine with YuE2)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
COMFYUI_PATH=/Users/daniel/ComfyUI

# Storage and Directories
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/studio.db
OUTPUTS_DIR=./outputs
VOICES_DIR=./voices
MODELS_DIR=./models
WORKFLOWS_DIR=./workflows
CONFIG_DIR=./config
LOGS_DIR=./logs

# Memory Management (Tuned for 24GB Unified Memory on Apple Silicon)
MAX_CONCURRENT_HEAVY_JOBS=1
MIN_FREE_MEMORY_GB=4.0
AUTO_UNLOAD_MODELS=true
WARN_QWEN_MAX_PARAMS_B=14
