{
  "workflow_id": "voice_reference",
  "name": "YuE2 Vocal Clone / Timbre Conditioning",
  "description": "Synthesizes song using an uploaded user vocal reference clip for voice timbre matching.",
  "required_nodes": [
    "YuE2Sampler",
    "YuE2CheckpointLoader",
    "LoadAudio",
    "YuE2TextConditioning",
    "YuE2VoiceConditioning",
    "YuE2AudioDecoder",
    "SaveAudio"
  ],
  "parameter_mapping": {
    "lyrics": {
      "node_id": "6",
      "input_name": "prompt",
      "type": "string"
    },
    "style_tags": {
      "node_id": "6",
      "input_name": "style_tags",
      "type": "string"
    },
    "reference_audio": {
      "node_id": "5",
      "input_name": "audio",
      "type": "audio_filename"
    },
    "voice_strength": {
      "node_id": "7",
      "input_name": "strength",
      "type": "float",
      "default": 0.85
    },
    "seed": {
      "node_id": "3",
      "input_name": "seed",
      "type": "integer"
    },
    "steps": {
      "node_id": "3",
      "input_name": "steps",
      "type": "integer",
      "default": 50
    },
    "duration": {
      "node_id": "3",
      "input_name": "duration_seconds",
      "type": "integer",
      "default": 60
    },
    "model_name": {
      "node_id": "4",
      "input_name": "model_name",
      "type": "string"
    }
  },
  "output_node": {
    "node_id": "12",
    "output_type": "audio"
  }
}
