{
  "workflow_id": "text_to_song",
  "name": "YuE2 Text-to-Song Standard",
  "description": "Synthesizes an original full vocal song from lyrics and genre style tags using YuE2 in ComfyUI.",
  "required_nodes": [
    "YuE2Sampler",
    "YuE2CheckpointLoader",
    "YuE2TextConditioning",
    "YuE2AudioDecoder",
    "SaveAudio"
  ],
  "parameter_mapping": {
    "lyrics": {
      "node_id": "6",
      "input_name": "prompt",
      "type": "string"
    },
    "style_tags": {
      "node_id": "6",
      "input_name": "style_tags",
      "type": "string"
    },
    "seed": {
      "node_id": "3",
      "input_name": "seed",
      "type": "integer"
    },
    "steps": {
      "node_id": "3",
      "input_name": "steps",
      "type": "integer",
      "default": 50
    },
    "cfg": {
      "node_id": "3",
      "input_name": "cfg",
      "type": "float",
      "default": 3.0
    },
    "duration": {
      "node_id": "3",
      "input_name": "duration_seconds",
      "type": "integer",
      "default": 60
    },
    "model_name": {
      "node_id": "4",
      "input_name": "model_name",
      "type": "string"
    },
    "precision": {
      "node_id": "4",
      "input_name": "precision",
      "type": "string",
      "default": "bf16"
    }
  },
  "output_node": {
    "node_id": "12",
    "output_type": "audio"
  }
}
